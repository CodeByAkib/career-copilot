
FLASK_SECRET_KEY=replace-with-a-long-random-string

# Atlas -> Connect -> Drivers. URL-encode special characters in the password (@ -> %40).
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=career_copilot

# Google AI Studio key
GEMINI_API_KEY=your-gemini-api-key
